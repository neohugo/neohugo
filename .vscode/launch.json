  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Mage Test",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${env:GOPATH}/bin/mage",
      "output": "${workspaceFolder}/bin",
      "env": {
        "HUGO_BUILD_TAGS": "extended"
      },
      "args": ["-v", "test"],
      "showLog": true
    }
  ]
}
