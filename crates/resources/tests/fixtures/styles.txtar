A small stylesheet and a PostCSS configuration for the CSS pipeline tests (`to_css`,
`post_css`, `post_process`): Sass partials, a component in a subdirectory, colour functions,
@each, a slash division, and a purge step that reads the build's stats file.
-- postcss.config.js --
// A tiny purge step (like PurgeCSS): drops rules whose classes are all missing from
// ./build_stats.json, so the CSS depends on the stats of this build.
const fs = require('fs');
const purge = () => ({
  postcssPlugin: 'purge-lite',
  Once(root) {
    const stats = JSON.parse(fs.readFileSync('./build_stats.json', 'utf8')).htmlElements;
    const keep = new Set([...(stats.classes || []), ...(stats.tags || [])]);
    root.walkRules((rule) => {
      const classes = (rule.selector.match(/\.[A-Za-z][A-Za-z0-9_-]*/g) || []).map((c) => c.slice(1));
      if (classes.length && !classes.some((c) => keep.has(c))) {
        rule.remove();
      }
    });
    root.append({ text: 'env: ' + process.env.FUGO_ENVIRONMENT });
  },
});
purge.postcss = true;
module.exports = { plugins: [purge()] };
-- assets/scss/website.scss --
@import "variables";
@import "components/card";

$gutter: 12px !default;

body {
  font-family: $font-stack;
  color: darken($primary, 10%);
  margin: 0 auto;
  max-width: 72rem;
}

.pagination {
  display: flex;
  li { padding: $gutter / 2; &.active { font-weight: bold; } }
}

.rating-star { color: mix($primary, #ffcc00, 25%); }
.never-used-class { color: red; }
.tag-list a:hover { text-decoration: underline; }
.breadcrumb, .nav-main { display: flex; flex-wrap: wrap; }

@each $name in brand, category, company {
  .tax-#{$name} { border-left: 2px solid lighten($primary, 20%); }
}
-- assets/scss/_variables.scss --
$primary: #d2691e;
$font-stack: "Inter", Helvetica, sans-serif;
-- assets/scss/components/_card.scss --
.card {
  border-radius: 4px;
  .card-title { font-size: 1.25rem; }
  img { width: 100%; height: auto; }
}
.card-unused { display: none; }
