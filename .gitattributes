# Text files have auto line endings
* text=auto

# Go source files always have LF line endings
*.go text eol=lf

# SVG files should not be modified
*.svg -text

# Rust port: test fixtures and golden/test data must be stored byte-exact
# (some contain CRLF that text=auto would rewrite).
rust/testdata/** -text
tools/rust-port/testdata/** -text
tools/rust-port/golden/** -text
tools/rust-port/site-overlay/** -text
