{#- Home: the site's regular pages; a section: its regular pages; taxonomies and terms: their pages. -#}
{%- set pages = site.regular_pages if page.is_home else (page.regular_pages if page.is_section else page.pages) -%}
{%- set limit = site.config.services.rss.limit -%}
{%- set pages = pages[:limit] if limit >= 1 else pages -%}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{% if page.title == site.title %}{{ site.title }}{% else %}{% if page.title %}{{ page.title }} on {% endif %}{{ site.title }}{% endif %}</title>
    <link>{{ page.permalink }}</link>
    <description>Recent content {% if page.title != site.title %}{% if page.title %}in {{ page.title }} {% endif %}{% endif %}on {{ site.title }}</description>
    <language>{{ site.language_code }}</language>
    <copyright>{{ site.params.yearcreate }}-{{ now() | date(format="%Y") }} {% if (site.params.yearcreate | int) >= (now() | date(format="%Y") | int) %}same{% endif %}</copyright>
    {% if page.output_formats.rss %}{% set rss = page.output_formats.rss %}<atom:link href="{{ rss.permalink }}" rel="self" type="{{ rss.media_type.type }}" />{% endif %}
    {% for p in pages %}
    <item>
      <title>{{ p.title }}</title>
      <link>{{ p.permalink }}</link>
      <pubDate>{{ p.date | date(format="%a, %d %b %Y %H:%M:%S %z") }}</pubDate>
      <guid>{{ p.permalink }}</guid>
      {% if p.params.categories %}{% set c = p.params.categories %}<category>{{ (c[0] if c is array else c) | humanize }}</category>{% endif %}
      <description>{{ p.summary | html_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
